---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedPosts } from '../../content/blog-utils';

const latestPosts = (await getPublishedPosts('blogEn'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  lang="en"
  title="Home"
  description="Developer — technical articles and projects."
>
  <section class="hero">
    <h1 class="hero__title">
      Hi, I'm <mark>Guillaume Miranda</mark>
    </h1>
    <p class="hero__desc">
      Full-stack developer based in Paris. I write about web development and
      share my projects here.
    </p>
    <p class="hero__links">
      <a href="/en/cv/">See my background</a> · <a href="/en/projects/"
        >See my projects</a
      >
    </p>
  </section>
  <section>
    <h2>Latest articles</h2>
    {
      latestPosts.map((post) => (
        <ArticleCard
          title={post.data.title}
          description={post.data.description}
          pubDate={post.data.pubDate}
          tags={post.data.tags}
          href={`/en/blog/${post.id}/`}
          lang="en"
          draft={post.data.draft}
        />
      ))
    }
  </section>
</BaseLayout>

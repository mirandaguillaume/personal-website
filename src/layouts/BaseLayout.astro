---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLang } from '../i18n/ui';
import type { Lang } from '../i18n/ui';
import { alternatePath, otherLang } from '../i18n/alternates';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /**
   * Chemin de cette page dans l'autre langue. Déduit du préfixe de langue si
   * absent ; les articles, dont les slugs sont traduits, le passent
   * explicitement. `null` signifie « aucune traduction publiée ».
   */
  alternate?: string | null;
  ogType?: 'website' | 'article';
}

const { lang, title, description, alternate, ogType = 'website' } = Astro.props;

const other = otherLang(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);

const alternateHref =
  alternate === undefined
    ? alternatePath(Astro.url.pathname, other)
    : alternate;

// Une URL par langue disponible : sert à la fois aux balises hreflang et au
// sélecteur de langue, pour qu'ils ne puissent pas diverger.
const urlByLang = new Map<Lang, URL>([[lang, canonical]]);
if (alternateHref) {
  urlByLang.set(other, new URL(alternateHref, Astro.site));
}
const xDefault = urlByLang.get(defaultLang);

const ogLocale = { fr: 'fr_FR', en: 'en_US' } as const;
// Image de partage statique, déclinée par langue : le visuel est identique
// partout, seul son texte suit la langue de la page.
const ogImage = new URL(
  lang === 'fr' ? '/og-default.png' : '/og-default-en.png',
  Astro.site,
);
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@500;700;800&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="canonical" href={canonical.href} />
    {
      [...urlByLang].map(([code, url]) => (
        <link rel="alternate" hreflang={code} href={url.href} />
      ))
    }
    {
      xDefault && (
        <link rel="alternate" hreflang="x-default" href={xDefault.href} />
      )
    }

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:site_name" content="Guillaume Miranda" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      alternateHref && (
        <meta property="og:locale:alternate" content={ogLocale[other]} />
      )
    }
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content="Guillaume Miranda" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
  </head>
  <body>
    <Header lang={lang} alternate={alternateHref} />
    <main class="site-main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

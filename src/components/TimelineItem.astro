---
import type { Lang } from '../i18n/ui';
import { formaterPeriode } from '../cv/periode';

interface Props {
  role: string;
  organization: string;
  startDate: Date;
  endDate?: Date;
  description: string;
  achievements?: string[];
  stack?: string[];
  lang: Lang;
}

const {
  role,
  organization,
  startDate,
  endDate,
  description,
  achievements = [],
  stack = [],
  lang,
} = Astro.props;
const periode = formaterPeriode(lang, { startDate, endDate });
---

<div class="timeline-item">
  <h3>{role} — {organization}</h3>
  <p class="article-card__date">{periode}</p>
  <p>{description}</p>
  {
    achievements.length > 0 && (
      <ul>
        {achievements.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    )
  }
  {stack.length > 0 && <p class="cv-stack">{stack.join(' · ')}</p>}
</div>
